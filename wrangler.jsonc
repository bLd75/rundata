{
  // Cloudflare Worker serving the MCP endpoint (see src/worker.ts). `npx wrangler dev` runs it locally, no account needed.
  "name": "reunion-temps-reel",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Secret, not in this file: METEOFRANCE_APPLICATION_ID, set with `npx wrangler secret put`. Without it, no Météo-France stations.
  // Served on rundata.re only: the edge cache does nothing on *.workers.dev, and one public address is enough.
  "routes": [{ "pattern": "rundata.re", "custom_domain": true }],
  "workers_dev": false,
  // The press page's visuals (public/presse/, built by scripts/build-presse.py): served by Cloudflare before the Worker
  // runs and not in its bundle. Their names change with their content, so public/_headers lets browsers keep them.
  "assets": { "directory": "./public" },
  "preview_urls": false,
  // Every 5 minutes, fills the bundle of the latest AROME run (src/worker.ts), about 35 grids per run of it.
  "triggers": { "crons": ["*/5 * * * *"] },
  // The AROME bundles, shared by every data center. Id from `npx wrangler kv namespace create STORE`.
  "kv_namespaces": [{ "binding": "STORE", "id": "1f961db9ed58429f9687eb6c438981f4" }],
  // The bus timetables (src/providers/transit.ts), imported by scripts/build-transit.py.
  // And the daily measurements of every Météo-France station since 1900 (src/providers/climat.ts), imported by
  // scripts/build-climat.py, the current year refreshed every morning by .github/workflows/climat.yml.
  "d1_databases": [
    { "binding": "TRANSIT", "database_name": "rundata-transports", "database_id": "5e304e2c-24c6-4dff-a6e7-ab674bb84016" },
    { "binding": "CLIMAT", "database_name": "rundata-climat", "database_id": "11df4a82-43e5-47aa-af77-6f5bfd9a5f0b" },
    { "binding": "CLIMAT_H", "database_name": "rundata-climat-h", "database_id": "51deb91a-028e-452c-b61b-09db74fc1730" },
    // The feedback of the tool donner_avis and of the site's form (src/avis.ts): the table `avis` of scripts/avis.sql,
    // next to the timetables, which never touch it. And what the clubs send (src/propositions.ts): the tables `liens`
    // and `propositions` of scripts/propositions.sql.
    { "binding": "AVIS", "database_name": "rundata-transports", "database_id": "5e304e2c-24c6-4dff-a6e7-ab674bb84016" }
  ],
  // Cloudflare Email Sending (Workers Paid, domain rundata.re onboarded): the confirmation link of the events the clubs
  // propose, from evenements@rundata.re (src/propositions.ts).
  "send_email": [{ "name": "EMAIL" }],
  // Usage counts (src/metrics.ts): one point per tool call and per page view, no address, no cookie.
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "rundata_usage" }]
}
